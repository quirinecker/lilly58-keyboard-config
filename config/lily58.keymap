#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"


&mt {
    tapping-term-ms = <280>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <13 14 15 16>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <19 20 21 22>;
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tml: tml {
            compatible = "zmk,behavior-hold-tap";
            label = "TML";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <53>;
        };

        tmr: tmr {
            compatible = "zmk,behavior-hold-tap";
            label = "TMR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <54>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_super_left {
            bindings = <&kp LEFT_GUI>;
            key-positions = <28 53>;
        };

        combo_super_right {
            bindings = <&kp LEFT_GUI>;
            key-positions = <31 54>;
        };

        combo_ctrl_left {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <27 53>;
        };

        combo_alt_left {
            bindings = <&kp LEFT_ALT>;
            key-positions = <26 53>;
        };

        combo_ctrl_right {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <32 54>;
        };

        combo_alt_right {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <33 54>;
        };

        combo_shift_right {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <54 34>;
        };

        combo_shift_left {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <53 25>;
        };
    };

    macros {
        macro_left_gui_l0: macro_gui_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &mo 0>, <&macro_press>;

            label = "MACRO_GUI_L0";
        };

        macro_right_gui_l0: macro_right_gui_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RGUI &mo 0>, <&macro_press>;

            label = "MACRO_RIGHT_GUI_L0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3    &kp N4            &kp N5                          &kp N6  &kp N7             &kp N8         &kp N9   &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E     &kp R             &kp T                           &kp Y   &kp U              &kp I          &kp O    &kp P     &kp EQUAL
&kp ESCAPE  &kp A   &kp S   &kp D     &kp F             &kp G                           &kp H   &kp J              &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C     &kp V             &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M              &kp COMMA      &kp DOT  &kp FSLH  &kp RSHFT
                            &kp LALT  &kp LEFT_CONTROL  &mo 1   &kp SPACE    &kp ENTER  &mo 2   &kp RIGHT_CONTROL  &kp RIGHT_ALT
            >;
        };

        mod_left {
            bindings = <
&trans  &trans     &trans    &trans     &trans        &trans                    &trans  &trans  &trans  &trans  &trans         &trans
&trans  &trans     &trans    &trans     &trans        &trans                    &trans  &trans  &trans  &trans  &trans         &trans
&trans  &kp LSHFT  &kp LALT  &kp LCTRL  &kp LEFT_GUI  &trans                    &trans  &trans  &trans  &trans  &kp BACKSPACE  &trans
&trans  &trans     &trans    &trans     &mo 3         &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans         &trans
                             &trans     &trans        &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        mod_right {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans         &trans             &trans         &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans         &trans             &trans         &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mo 3          &trans             &trans         &trans           &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans         &trans
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2            &bt BT_SEL 3          &bt BT_SEL 4                     &trans        &trans        &trans        &trans        &trans         &kp DE_A_UMLAUT
&kp F1      &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3            &kp NUMBER_4          &kp NUMBER_5                     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp F12
&kp GRAVE   &kp EXCL      &hml LEFT_ALT AT  &hml LEFT_CONTROL HASH  &hml LEFT_GUI DOLLAR  &kp PRCNT                        &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp BACKSPACE  &kp DELETE
&trans      &trans        &trans            &trans                  &trans                &trans        &trans    &trans   &trans        &kp MINUS     &kp KP_PLUS   &kp LBRC      &kp BACKSLASH  &kp PIPE
                                            &trans                  &trans                &trans        &trans    &kp RET  &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans     &trans  &trans  &trans   &trans   &trans                     &trans       &trans     &trans     &trans    &trans     &trans
&kp GRAVE  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                     &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &trans
&kp F1     &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans       &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
                           &trans   &trans   &trans   &trans    &trans  &trans       &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
